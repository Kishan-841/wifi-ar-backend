// Deliberately minimal (plan §35): two tables. Rooms, users, and access points
// stay as columns/absent until a phase needs them as entities.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scan {
  id           String        @id @default(uuid())
  startedAt    DateTime
  endedAt      DateTime
  ssid         String?
  /** User-declared room footprint in grid boxes (0.5 m cells), optional. */
  shapeW       Int?
  shapeH       Int?
  createdAt    DateTime      @default(now())
  measurements Measurement[]
}

model Layout {
  id         String          @id @default(uuid())
  name       String
  cols       Int
  rows       Int
  createdAt  DateTime        @default(now())
  placements RoomPlacement[]
}

model RoomPlacement {
  id       Int    @id @default(autoincrement())
  layoutId String
  layout   Layout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  scanId   String
  col      Int
  row      Int
  /** Quarter turns clockwise: 0..3 */
  rotation Int

  @@unique([layoutId, scanId])
}

model Measurement {
  id              Int      @id @default(autoincrement())
  scanId          String
  scan            Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  timestamp       DateTime
  x               Float
  y               Float
  z               Float
  rssi            Int
  ssid            String
  bssid           String
  frequency       Int
  trackingQuality String
  room            String?

  @@index([scanId])
}
