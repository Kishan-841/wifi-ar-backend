# Copy to .env on the VM and fill in. `.env` is gitignored; never commit it.

# Database password (internal only; the DB port is not published). Any long random string.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Localhost port the API is published on. nginx proxies the public hostname to it.
# Must match proxy_pass in nginx/wifi-ar.conf.
PUBLIC_PORT=8080

# Public URL the app talks to (nginx + certbot). Used by tools/deploy-vm.sh for its health check.
API_URL=https://202-136-68-13.sslip.io

# First admin account, consumed once by:  docker compose exec api npm run seed:admin
ADMIN_NAME=Kishan
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=pick-a-real-password-min-8-chars
